root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# C# templates follow the conventions of the projects they generate (dbaitest/db-test).
[*.{cs,cs.template}]
indent_size = 4
