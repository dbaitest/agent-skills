<Project Sdk="Microsoft.Build.Sql/2.3.0">

  <!--
    A minimal SDK-style database project. CI scaffolds a test project against it in dacpac mode
    (from the project, and from its built .dacpac) and runs it on SQL Server.
  -->
  <PropertyGroup>
    <Name>Shop.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <IsPackable>false</IsPackable>
    <DacFxTelemetryEnabled>false</DacFxTelemetryEnabled>
  </PropertyGroup>

</Project>
